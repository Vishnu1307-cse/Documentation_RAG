# API Keys for Cloud LLM Providers
# Fill in the keys you intend to use. At least one must be set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1
ALLOWED_CORS_ORIGINS=http://localhost:5173

# Application Settings
LLM_PROVIDER=openai  # openai | anthropic | gemini | deepseek
CHROMA_DB_PATH=./chroma_db
SANDBOX_DIR=./temp_repos
GENERATED_DOCS_DIR=./generated_docs
MAX_REPO_SIZE_MB=50

# LLM Models Configuration
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_MODEL=gemini-1.5-flash
DEEPSEEK_MODEL=deepseek-chat
